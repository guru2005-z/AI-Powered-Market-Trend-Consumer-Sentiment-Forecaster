# ==========================================
# AI-Powered Market Trend & Consumer Sentiment Forecaster
# Environment Variables Configuration
# ==========================================

# 1. Google Gemini API Key (Required for RAG Chatbot and Executive Reports)
# Get a free key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Pinecone API Key (Required for Vector Database and Similarity Search)
# Get a free key at: https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# 3. Groq API Key (Optional: Used for Fast Sentiment Classification & Topic Extraction)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 4. YouTube API Key (Optional: Used for Scraping YouTube comments)
# Get a key from Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_here

# 5. Email Reporting Credentials (Optional: Used for Automated Email Reports)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

